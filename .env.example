# Kopier til .env og fyll inn. .env skal aldri i git.
# Regel: én nøkkel per tjeneste. docker-compose.yml gir hver tjeneste bare sine egne.

# --- Felles ---
# Delt hemmelighet mellom web, search og agent. Minst 32 tegn.
INTERNAL_TOKEN=

# --- MySQL (bare web) ---
MYSQL_DATABASE=creativeart
MYSQL_USER=creativeart
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Anthropic (bare agent) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Voyage (bare search) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# --- Langfuse (kobles til når sporing settes opp, steg 4 i docs/ARKITEKTUR.md) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Hemmelighet for HMAC av besøkendes enhetstoken (bare web). Minst 32 tegn. ---
APP_SECRET=
