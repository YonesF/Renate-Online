# Kopier denne filen til .env.local og fyll inn det du har.
# ALT er valgfritt: uten nøkler kjører prototypen i demo-modus med lokalt søk i Markdown-filene.
# Alle kontoer skal på sikt eies av Creative Art, ikke av studentene.

# ── Språkmodell (velg én) ─────────────────────────────────────
# LLM_PROVIDER=anthropic          # anthropic | openai | google (velges automatisk ut fra nøkkel hvis tom)
# LLM_MODEL=                      # standard: claude-haiku-5-5 / gpt-5.4-mini / gemini-flash-latest
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Kunnskapsbase i Supabase (region Stockholm) ───────────────
# Uten disse brukes lokalt søk i content/guider.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # KUN på serveren. Aldri i NEXT_PUBLIC_-variabler.

# ── Embeddings og reranking ───────────────────────────────────
# EMBEDDING_PROVIDER=cohere       # cohere | openai
COHERE_API_KEY=                   # brukes til embeddings og reranking
# RERANK_MODEL=rerank-v3.5

# ── Eskalering til Renate ─────────────────────────────────────
RESEND_API_KEY=
ESKALERING_EPOST=                 # Renates e-postadresse
# ESKALERING_AVSENDER=Renate Online <hjelp@creativeart.no>

# ── Butikk og sikkerhet ───────────────────────────────────────
# NEXT_PUBLIC_STORE_URL=https://creativeart.no
# NEXT_PUBLIC_MESSENGER_URL=https://www.facebook.com/creativeart.no
# ALLOWED_FRAME_ANCESTORS='self' https://creativeart.no https://din-testbutikk.myshopify.com
# RATE_LIMIT_PER_MINUTE=20
