{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/index: forespørsel",
  "description": "Sendes av web (kb:index). Passasjene er allerede delt opp og lagret i MySQL. search lager embeddings og skriver Qdrant og Tantivy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection", "passages"],
  "properties": {
    "collection": { "enum": ["kb", "products"] },
    "passages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/passage" }
    }
  },
  "$defs": {
    "uid": { "type": "string", "pattern": "^[a-z]{2}[a-z0-9]{26}$" },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "document", "ord", "title", "path", "anchor", "text", "hash", "audience", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/uid" },
        "document": { "$ref": "#/$defs/uid" },
        "ord": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 av teksten. Uendret hash betyr at embedding kan gjenbrukes."
        },
        "audience": { "enum": ["public", "customer", "internal"] },
        "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "status": { "enum": ["draft", "published"] }
      }
    }
  }
}
