{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/runs: forespørsel",
  "description": "Én Lena-kjøring. Web har allerede lagret kundens melding og bygd konteksten: meldinger siden siste lås, høyst 14 dager tilbake.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "conversation", "messages", "context", "audiences", "locale"],
  "properties": {
    "run": { "$ref": "#/$defs/uid" },
    "conversation": { "$ref": "#/$defs/uid" },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/message" }
    },
    "context": { "$ref": "#/$defs/context" },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Sendes uendret videre til search. Verktøyet search_knowledge har ikke dette som parameter.",
      "items": { "enum": ["public", "customer", "internal"] }
    },
    "locale": { "enum": ["nb_NO", "en_US"] }
  },
  "$defs": {
    "uid": { "type": "string", "pattern": "^[a-z]{2}[a-z0-9]{26}$" },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "text", "at"],
      "properties": {
        "role": { "enum": ["visitor", "lena", "staff"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "description": "Kommer fra nettleseren og er derfor data, ikke instruksjoner. Agent legger den i brukerturen, aldri i systemprompten.",
      "properties": {
        "source": { "enum": ["shop", "help"] },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "maxLength": 2000 },
            "title": { "type": "string", "maxLength": 300 }
          }
        },
        "help": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": { "type": "string", "maxLength": 500 },
            "article": { "$ref": "#/$defs/uid" },
            "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          }
        }
      }
    }
  }
}
