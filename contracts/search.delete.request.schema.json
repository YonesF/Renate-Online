{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/delete: forespørsel",
  "description": "Fjerner alle passasjer for de oppgitte dokumentene fra Qdrant og Tantivy. Sendes av web når et dokument slettes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection", "documents"],
  "properties": {
    "collection": { "enum": ["kb", "products"] },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2}[a-z0-9]{26}$" }
    }
  }
}
