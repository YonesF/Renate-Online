#!/usr/bin/env php
<?php

declare(strict_types=1);

// Første del av kvalitetsporten:
//   1. php -l på hver fil
//   2. hver fil har declare(strict_types=1)
//   3. superglobals leses bare i input-laget

$root = dirname(__DIR__);
$inputLayer = ['application/Http/Request.php'];
$superglobal = '/\$(?:_SERVER|_GET|_POST|_COOKIE|_FILES|_REQUEST|_ENV|_SESSION|GLOBALS)\b/';
$strictTypes = '/^(?:#![^\n]*\n)?<\?php\s+declare\(strict_types=1\);/';

$files = ["{$root}/bootstrap.php", "{$root}/bin/console", "{$root}/bin/lint"];
foreach (['application', 'configuration', 'public', 'sites', 'tests'] as $directory) {
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator("{$root}/{$directory}", FilesystemIterator::SKIP_DOTS),
    );
    foreach ($iterator as $file) {
        if ($file instanceof SplFileInfo && $file->getExtension() === 'php') {
            $files[] = $file->getPathname();
        }
    }
}
sort($files);

$errors = [];
foreach ($files as $file) {
    $relative = str_replace('\\', '/', substr($file, strlen($root) + 1));

    $output = [];
    exec(escapeshellarg(PHP_BINARY) . ' -l ' . escapeshellarg($file) . ' 2>&1', $output, $status);
    if ($status !== 0) {
        $errors[] = "{$relative}: syntaksfeil\n    " . implode("\n    ", $output);
        continue;
    }

    $source = (string) file_get_contents($file);
    if (preg_match($strictTypes, $source) !== 1) {
        $errors[] = "{$relative}: mangler declare(strict_types=1) øverst";
    }
    if (!in_array($relative, $inputLayer, true) && preg_match($superglobal, $source, $match) === 1) {
        $errors[] = "{$relative}: leser {$match[0]}. Superglobals leses bare i {$inputLayer[0]}";
    }
}

if ($errors !== []) {
    fwrite(STDERR, implode("\n", $errors) . "\n\nbin/lint: " . count($errors) . " feil\n");
    exit(1);
}

echo 'bin/lint: ' . count($files) . " filer, ingen feil\n";
