{
    "name": "creativeart/web",
    "description": "CreativeArt: hjelpeside, Lena-panel og konsoll",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-pdo": "*",
        "league/commonmark": "^2.10",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "application/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php bin/lint",
        "stan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
