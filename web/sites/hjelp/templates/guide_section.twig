<details class="guide-section" id="{{ id }}">
  <summary class="guide-toggle">
    <span class="guide-step" aria-hidden="true">{{ step }}</span>
    <span class="guide-heading">
      <h2 class="guide-title">{{ title }}</h2>
      {% if desc is defined and desc %}
      <span class="guide-desc">{{ desc }}</span>
      {% endif %}
    </span>
    <span class="guide-action" aria-hidden="true">
      <svg class="guide-chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </span>
  </summary>
  <div class="guide-body prose">
    {% block body %}{% endblock %}
  </div>
</details>
