<details class="guide-section" id="{{ id }}">
  <summary class="guide-toggle">
    <span class="guide-step" aria-hidden="true">{{ step }}</span>
    <span class="guide-heading">
      <h2 class="guide-title">{{ title }}</h2>
      {% if desc is defined and desc %}
      <span class="guide-desc">{{ desc }}</span>
      {% endif %}
    </span>
    <span class="guide-action" aria-hidden="true">
      <span class="guide-action-open">Åpne</span>
      <span class="guide-action-close">Lukk</span>
      <svg class="guide-chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </span>
  </summary>
  <div class="guide-body prose">
    {% block body %}{% endblock %}
    <div class="guide-body-footer">
      <button type="button" class="guide-close-btn" data-close-section>
        <span>Lukk dette temaet</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
      </button>
    </div>
  </div>
</details>
