{% extends "layout.twig" %}

{% block header %}
<a class="skip" href="#innhold">Hopp til innholdet</a>
<div class="announcement">
  <div class="wrap">Hjelp med produkter, prosjekt og tekniske utfordringer</div>
</div>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/" aria-label="CreativeArt hjelpesenter - forsiden">
      <img class="brand-logo" src="/assets/creativeart-logo-light.png" alt="CreativeArt" width="814" height="180">
      <span class="brand-section">Hjelpesenter</span>
    </a>
    <nav class="topbar-nav" aria-label="Hovednavigasjon">
      <a class="topbar-link" href="https://creativeart.no/" rel="noopener">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h13"/>
          <path d="M13 7l5 5-5 5"/>
        </svg>
        <span>Gå til nettbutikken</span>
      </a>
    </nav>
  </div>
</header>
{% endblock %}

{% block body %}
<main id="innhold">
{% block main %}{% endblock %}

{% block ask %}
{% if panel_origin %}
<section class="wrap section">
  <div class="ask">
    <div class="ask-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5.5 4.5h13A2.5 2.5 0 0 1 21 7v8a2.5 2.5 0 0 1-2.5 2.5H10l-5 4v-4.2A2.5 2.5 0 0 1 3 15V7a2.5 2.5 0 0 1 2.5-2.5z"/>
        <path d="M8 11h.01M12 11h.01M16 11h.01"/>
      </svg>
    </div>
    <div class="ask-copy">
      <h2>Fant du ikke svaret?</h2>
      <p>Chat med Lena og få hjelp med produkter, tekniske spørsmål og feilsøking.</p>
      <button type="button" class="button" data-chat-open>
        <span>Start chat</span>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 7l5 5-5 5"/></svg>
      </button>
    </div>
  </div>
</section>
{% endif %}
{% endblock %}

{% block bottom_nav %}{% endblock %}
</main>
{% endblock %}

{% block footer %}
<footer class="footer">
  <div class="wrap footer-inner">
    <p class="footer-copy">CreativeArt Hjelpesenter<br>© 2026 CreativeArt.no</p>
    <nav class="footer-contact-group" aria-label="Kontakt og sosiale medier">
      <a class="footer-contact" href="https://creativeart.no/pages/kontakt">
        Kontakt oss <span aria-hidden="true"></span>
      </a>
      <span class="footer-group-divider" aria-hidden="true"></span>
      <div class="social-links" aria-label="CreativeArt på sosiale medier">
      <a href="https://www.facebook.com/creativeart.no" target="_blank" rel="noopener noreferrer" aria-label="CreativeArt på Facebook" title="Facebook">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V7.2c0-.7.5-1.2 1.2-1.2h2V3h-2.7A4.5 4.5 0 0 0 10 7.5v1H7.5v3H10v7h4v-7h2.7l.4-3H14z"/></svg>
      </a>
      <a href="https://www.youtube.com/channel/UCZlDdm9rvNMwwZJ4smCJg5g" target="_blank" rel="noopener noreferrer" aria-label="CreativeArt på YouTube" title="YouTube">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.8 31.8 0 0 0 0 12a31.8 31.8 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.8 31.8 0 0 0 24 12a31.8 31.8 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
      </a>
      <a href="https://www.instagram.com/creativeartno" target="_blank" rel="noopener noreferrer" aria-label="CreativeArt på Instagram" title="Instagram">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href="https://tiktok.com/@creativeartno" target="_blank" rel="noopener noreferrer" aria-label="CreativeArt på TikTok" title="TikTok">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M16.7 2c.3 2.5 1.7 4.1 4.3 4.3v3.2a8.4 8.4 0 0 1-4.3-1.2v6.5A6.3 6.3 0 1 1 11.2 8c.4 0 .8 0 1.2.1v3.4a3 3 0 1 0 1.7 2.7V2h2.6z"/></svg>
      </a>
      <a href="https://www.snapchat.com/p/creativeartno" target="_blank" rel="noopener noreferrer" aria-label="CreativeArt på Snapchat" title="Snapchat">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2.5c-3 0-5 2.1-5 5.2 0 1.1-.2 2.2-.7 3.2-.4.8-.9 1.4-1.7 1.8-.5.2-.6.7-.3 1.1.3.4.9.5 1.4.6.6.1 1.1.3 1.2.8.1.4-.2.8-.5 1.1-.4.4-.8.7-.6 1.1.2.4.7.5 1.2.5.7.1 1.4.4 1.9.9.6.6 1.4.9 2.1.9.8 0 1.5-.3 2.1-.9.5-.5 1.2-.8 1.9-.9.5-.1 1-.1 1.2-.5.2-.4-.2-.7-.6-1.1-.3-.3-.6-.7-.5-1.1.1-.5.6-.7 1.2-.8.5-.1 1.1-.2 1.4-.6.3-.4.2-.9-.3-1.1-.8-.4-1.3-1-1.7-1.8-.5-1-.7-2.1-.7-3.2 0-3.1-2-5.2-5-5.2z"/></svg>
      </a>
      </div>
    </nav>
  </div>
</footer>

{% if panel_origin %}
<aside class="chat" id="chat" data-origin="{{ panel_origin }}" aria-label="Chat med Lena" hidden>
  <button type="button" class="chat-close" data-chat-close aria-label="Lukk chatten">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</aside>
{% endif %}
<script nonce="{{ nonce }}" src="/assets/help.js?v={{ asset_version }}"></script>
{% endblock %}
