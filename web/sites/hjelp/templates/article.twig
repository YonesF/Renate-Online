{% extends "base.twig" %}
{% import "icons.twig" as icons %}

{% block title %}{{ document.title }} – Hjelp – CreativeArt{% endblock %}

{% block main %}
<div class="wrap page">
  <div class="page-top-bar">
    <nav class="page-back" aria-label="Tilbake til hjelpesenter øverst">
      {% include "back_button.twig" %}
    </nav>
    <nav class="crumbs" aria-label="Kategori og guide">
      <a href="/kategori/{{ document.categorySlug }}">{{ document.categoryName }}</a>
      {% if document.guideSlug %}
      <span aria-hidden="true">›</span>
      <a href="/kategori/{{ document.categorySlug }}#{{ document.guideSlug }}">{{ document.guideTitle }}</a>
      {% endif %}
    </nav>
  </div>
  <div class="article-layout{% if guideChapters is empty and toc|length < 2 %} article-layout-single{% endif %}">
    {% if guideChapters is not empty or toc|length >= 2 %}
    <aside class="toc" aria-labelledby="toc-tittel">
      <h2 id="toc-tittel">{% if guideChapters is not empty %}Kapitler i guiden{% else %}På denne siden{% endif %}</h2>
      <ol>
        {% if guideChapters is not empty %}
          {% for chapter in guideChapters %}
        <li class="toc-level-2"><a href="/artikkel/{{ chapter.slug }}">{{ chapter.title }}</a></li>
          {% endfor %}
        {% else %}
        {% for entry in toc %}
        <li class="toc-level-{{ entry.level }}"><a href="#{{ entry.id }}">{{ entry.text }}</a></li>
        {% endfor %}
        {% endif %}
      </ol>
    </aside>
    {% endif %}

    <article class="article">
      <h1>{{ document.title }}</h1>
      {# Trygt å skrive ut rått: Markdown-klassen escaper all HTML i kilden. #}
      <div class="prose" data-collapsible-markdown>{{ html|raw }}</div>

      {% if document.previous or document.next %}
      <nav class="pager" aria-label="Forrige og neste kapittel">
        {% if document.previous %}
        <a class="pager-link" href="/artikkel/{{ document.previous.slug }}">
          <span class="pager-label"><span aria-hidden="true">‹</span> Forrige</span>
          <span class="pager-title">{{ document.previous.title }}</span>
        </a>
        {% else %}<span></span>{% endif %}
        {% if document.next %}
        <a class="pager-link pager-next" href="/artikkel/{{ document.next.slug }}">
          <span class="pager-label">Neste <span aria-hidden="true">›</span></span>
          <span class="pager-title">{{ document.next.title }}</span>
        </a>
        {% endif %}
      </nav>
      {% endif %}
    </article>
  </div>
</div>
{% endblock %}

{% block bottom_nav %}
<section class="wrap more-categories" aria-labelledby="andre-kategorier">
  <h2 id="andre-kategorier">Prøv en annen kategori</h2>
  <nav class="more-categories-grid" aria-label="Andre hovedkategorier">
    {% set category_links = [
      {'slug': 'varmepresser', 'name': 'Varmepresser', 'href': '/kategori/varmepresser'},
      {'slug': 'sublimering', 'name': 'Sublimering', 'href': '/kategori/sublimering'},
      {'slug': 'vinyl-og-tekstil', 'name': 'Vinyl og tekstil', 'href': '/kategori/vinyl-og-tekstil'},
      {'slug': 'bestilling-og-levering', 'name': 'Bestilling og levering', 'href': 'https://creativeart.no/pages/fraktbetingelser'},
      {'slug': 'produkter-og-tilbehor', 'name': 'Produkter og tilbehør', 'href': 'https://creativeart.no/'}
    ] %}
    {% for item in category_links %}
      {% if item.slug != document.categorySlug %}
      <a class="more-category-card" href="{{ item.href }}">
        <span class="more-category-icon">{{ icons.category(item.slug) }}</span>
        <span class="more-category-title">{{ item.name }}</span>
        <span class="more-category-arrow" aria-hidden="true">→</span>
      </a>
      {% endif %}
    {% endfor %}
  </nav>
</section>
{% endblock %}

