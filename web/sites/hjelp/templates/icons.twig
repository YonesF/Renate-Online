{# Enkle strekikoner, tegnet for dette prosjektet. Én per kategori, bok som reserve. #}
{% macro category(slug) %}
<svg class="icon" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if slug == 'sublimering' %}
  <rect x="4" y="4" width="16" height="16" rx="2.5"/>
  <path d="M4 8.5h16"/>
  <path d="M7 6.25h2"/>
  <circle cx="12" cy="14.25" r="3.25"/>
  <circle cx="12" cy="14.25" r="0.8" fill="currentColor" stroke="none"/>
{% elseif slug == 'varmepresser' %}
  <rect x="4.5" y="15.5" width="15" height="3.2" rx="1"/>
  <path d="M6.5 15.5v-2.8"/>
  <path d="M5.2 12 18 7l1.1 2.7L6.3 14.7z"/>
  <path d="M10.3 10 9.4 7.7a1 1 0 0 1 .6-1.3l3.6-1.4a1 1 0 0 1 1.3.6l.9 2.3"/>
{% elseif slug == 'vinyl-og-tekstil' %}
  <rect x="5.5" y="4" width="8.5" height="16" rx="1.5"/>
  <circle cx="8" cy="6.8" r="0.85" fill="currentColor" stroke="none"/>
  <path d="M14 7.5 18.2 17.6a1.6 1.6 0 0 1-1.5 2.2H14"/>
{% elseif slug == 'bestilling-og-levering' %}
  <path d="M4.5 7h9v8.5h-9"/>
  <path d="M4.5 7v1.8M4.5 13.8v1.7"/>
  <path d="M1.5 9.8h3.5M2.5 11.8h2.5"/>
  <path d="M13.5 9.5h4l2.8 3.2v2.8h-6.8"/>
  <circle cx="7.8" cy="17.2" r="1.8"/>
  <circle cx="16.8" cy="17.2" r="1.8"/>
{% elseif slug == 'produkter-og-tilbehor' %}
  <path d="M12 3 20 7.5v9L12 21 4 16.5v-9L12 3z"/>
  <path d="M4 7.5 12 12l8-4.5"/>
  <path d="M12 12v9"/>
  <path d="M8 5.25 16 9.75"/>
{% else %}
  <path d="M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/>
  <path d="M5 17a3 3 0 0 1 3-3h10"/>
{% endif %}
</svg>
{% endmacro %}
